# Lead delivery. See docs/lead-delivery.md for how to create each of these.
# All are optional in development: with none set, leads are printed to the terminal.
# In production, having no destination at all is treated as a delivery failure, so
# the visitor is asked to try again rather than being told a lost request succeeded.

# --- Google Sheets ---
# The /exec URL of the Apps Script web app deployed from docs/leads-webhook.gs
SHEETS_WEBHOOK_URL=
# Shared secret. Must match SHARED_TOKEN inside the Apps Script, or anyone
# who learns the URL above can append rows to the sheet.
SHEETS_WEBHOOK_TOKEN=

# --- Email notification (Resend, https://resend.com) ---
RESEND_API_KEY=
# Who gets told about a new lead. Comma-separated for more than one.
LEAD_NOTIFY_EMAIL=
# Must be a domain verified in Resend. Without it, Resend's shared test sender is
# used, which only delivers to the address that owns the Resend account.
LEAD_FROM_EMAIL="Vidyam deAi Website <website@yourdomain.com>"
